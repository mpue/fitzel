+// fitzel patch (cmake/patches/glfw-wayland-window-monitor.patch): the monitor
+// a Wayland window is on -- the output its surface entered last. Wayland has no
+// primary monitor and tells a client nothing about where its window is except
+// through these enter/leave events, which GLFW already tracks for the content
+// scale. NULL on other platforms and before the surface has entered an output.
+GLFWAPI GLFWmonitor* glfwGetWaylandWindowOutputMonitor(GLFWwindow* handle)
+{
+    _GLFWwindow* window = (_GLFWwindow*) handle;
+    assert(window != NULL);
+
+    _GLFW_REQUIRE_INIT_OR_RETURN(NULL);
+#if defined(_GLFW_WAYLAND)
+    if (_glfw.platform.platformID == GLFW_PLATFORM_WAYLAND &&
+        window->wl.outputScaleCount > 0)
+    {
+        struct wl_output* output =
+            window->wl.outputScales[window->wl.outputScaleCount - 1].output;
+        for (int i = 0;  i < _glfw.monitorCount;  i++)
+        {
+            if (_glfw.monitors[i]->wl.output == output)
+                return (GLFWmonitor*) _glfw.monitors[i];
+        }
+    }
+#endif
+    return NULL;
+}
