+/*! @brief fitzel patch: the monitor a Wayland window is on.
+ *
+ *  The monitor whose output the window's surface entered last, or `NULL` when
+ *  it has not entered one yet or the platform is not Wayland.
+ */
+GLFWAPI GLFWmonitor* glfwGetWaylandWindowOutputMonitor(GLFWwindow* window);
