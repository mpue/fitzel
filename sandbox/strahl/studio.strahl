// A photo studio, for any scene that wants one:
//
//     import "studio"
//     cyclorama()
//     studio_lights()
//
// Lives in the library folder, so `import "studio"` finds it from anywhere.

// The seamless backdrop: a floor that sweeps up into a wall without a corner,
// so nothing behind the subject has an edge to catch the eye. `radius` is the
// bend; the backdrop's front edge is at z = depth / 2, its wall at -depth / 2.
fn cyclorama(width = 16, depth = 10, height = 7, radius = 2.5, color = #e6e4e0, segments = 24) {
    let back = -depth / 2
    let pts = [[0, depth / 2]]                      // [y, z], the front edge of the floor
    for i in 0..=segments {
        let a = i / segments * 90                   // from the floor up into the wall
        push(pts, [radius - radius * cos(a), back + radius - radius * sin(a)])
    }
    push(pts, [height, back])
    let vs = []
    let fs = []
    for pt in pts {
        push(vs, [-width / 2, pt[0], pt[1]])
        push(vs, [width / 2, pt[0], pt[1]])
    }
    for k in 0..len(pts) - 1 {
        push(fs, [2 * k, 2 * k + 1, 2 * k + 3, 2 * k + 2])
    }
    mesh { vertices: vs, faces: fs, smooth: true, material: matte(color) }
}

// Three soft lamps: a key light high on the left, a cooler fill low on the
// right, and a rim light behind to separate the subject from the backdrop.
// `warmth` is the key's colour temperature in kelvin.
fn studio_lights(key = 70, fill = 14, rim = 45, warmth = 5000) {
    light { position: [-4.5, 5.5, 4], intensity: key, radius: 1.4, color: kelvin(warmth) }
    light { position: [5, 2.5, 3.5], intensity: fill, radius: 1.8, color: kelvin(warmth + 2000) }
    light { position: [2.5, 4.5, -3.2], intensity: rim, radius: 0.7, color: kelvin(warmth + 1000) }
}
