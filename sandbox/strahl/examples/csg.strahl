// Constructive solid geometry: solids combined by union, merge, intersection
// and difference -- traced exactly, so every cut is a true curve and every
// hole a true cylinder, at any distance and any resolution.
import "studio"

render { width: 1280, height: 720, samples: 384, bounces: 10 }
camera { position: [0, 2.4, 7.4], look_at: [0, 0.75, 0], fov: 33, aperture: 0.025, focus: "auto" }
sky { zenith: #3a3d44, horizon: #686c74, ground: #2a2a2a, intensity: 0.4 }
cyclorama()
studio_lights()

// The classic: the overlap of a cube and a sphere, with three bores through it.
fn holed_cube(size = 1.4) {
    let h = size * 0.75
    let r = size * 0.22
    difference {
        intersection { box { size: size }; sphere { radius: size * 0.68 } }
        cylinder([0, -h, 0], [0, h, 0], r)
        cylinder([-h, 0, 0], [h, 0, 0], r)
        cylinder([0, 0, -h], [0, 0, h], r)
    }
}
holed_cube() { material: chrome, rotate: [0, 35, 0], translate: [0, 0.7, 0] }

// A lens: what two spheres have in common. Standing on its rim.
intersection {
    sphere([0, 0, -0.75], 1)
    sphere([0, 0, 0.75], 1)
    material: glass(white, 1.6)
    rotate: [0, 55, 0]
    translate: [-2.25, 0.662, 0.4]
}

// merge keeps no surface inside the result: three spheres of tinted glass
// become one body, coloured by how far light travels through it.
merge {
    sphere([0, 0, 0], 0.45)
    sphere([0.5, 0.1, 0.05], 0.36)
    sphere([0.22, 0.52, 0.1], 0.3)
    material: glass(white, 1.45, [0.05, 0.6, 1.4])
    translate: [2.05, 0.45, 0.55]
}

// A hexagon nut: three slabs at 60 degrees make the prism, a sphere takes the
// corners off as a chamfer would, and a cylinder bores the hole.
fn nut(r = 0.32, h = 0.28, hole = 0.16) {
    difference {
        intersection {
            box { size: [2 * r, h, 4 * r] }
            box { size: [2 * r, h, 4 * r], rotate: [0, 60, 0] }
            box { size: [2 * r, h, 4 * r], rotate: [0, 120, 0] }
            sphere { radius: sqrt((1.07 * r) ^ 2 + (h / 2) ^ 2) }
        }
        cylinder([0, -h, 0], [0, h, 0], hole)
    }
}
nut() { material: brass, rotate: [0, 10, 0], translate: [-0.95, 0.14, 1.55] }
nut() { material: steel, rotate: [90, 0, 30], translate: [0.85, 0.32, 1.7] }

// A bubble: the difference of two spheres is a shell.
difference {
    sphere { radius: 0.32 }
    sphere { radius: 0.3 }
    material: glass(white, 1.33)
    translate: [-1.25, 0.32, -0.9]
}
sphere([-1.25, 0.12, -0.9], 0.1, plastic(#d23a24, 0.2))
