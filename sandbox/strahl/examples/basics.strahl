// Strahl, first steps.          strahl basics.strahl  ->  basics.png
// The language reference is docs/strahl.md.

render { width: 1280, height: 720, samples: 256 }

// The eye: where it stands, what it looks at, and how much it sees (the
// vertical field of view, in degrees).
camera { position: [0, 1.4, 5.5], look_at: [0, 0.55, 0], fov: 36 }

// The sun from the upper left -- its disc 1.5 degrees across, so the shadows
// have soft edges -- and a sky for everything the sun does not reach.
sun { direction: [-1, 1.6, 0.8], intensity: 3.2, angle: 1.5 }
sky { zenith: #5277b5, horizon: #d8e2ec, ground: #4a4642 }

// A floor that goes on for ever, chequered in 50 cm squares.
plane { material: matte(checker(#e9e5dc, #5c5a55, size: 0.5)) }

// An object is its kind and { properties }. Colours are #rrggbb, vectors [x, y, z].
sphere { center: [-1.6, 0.6, 0], radius: 0.6, material: plastic(#c83a2c) }
box    { size: 1, center: [0, 0.5, 0], rotate: [0, 25, 0], material: gold }
sphere { center: [1.6, 0.6, 0], radius: 0.6, material: glass() }

// Values without names go in the kind's own order: center, radius -- and a
// material anywhere among them.
sphere { [-0.75, 0.2, 1.3], 0.2, chrome }

// Names and loops: a row of small spheres round the colour wheel.
let n = 9
for i in 0..n {
    let x = (i - (n - 1) / 2) * 0.42
    sphere { center: [x, 0.15, 1.9], radius: 0.15, material: plastic(hsv(i * 40, 0.75, 0.95), 0.15) }
}
