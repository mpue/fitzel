#version 430 core

// The preview's picture, made on the card.
//
// The tracer keeps SUMS in a float image; a screen wants eight bits through the
// tonemap and the colour grade. That conversion used to happen on the CPU: read
// the whole float image back, divide, tonemap a million pixels, upload the
// result. It cost about thirty milliseconds and, worse, it BLOCKED -- reading a
// texture the compute shader has just written waits for the card to finish
// everything queued behind it. So the preview could only afford to do it about
// four times a second, and every one of those was a hitch.
//
// Here it is a dispatch that writes straight into the texture the viewport
// draws. Nothing comes back over the bus, nothing stalls, and the picture can be
// refreshed every frame.
//
// THE CURVES ARE NOT NEW ONES. They are composite.frag's -- the same constants,
// the same gamma, the same grade in the same order -- which is also what
// pathtrace::tonemap transcribes for the offline still. Three copies of one
// curve is two too many, so gpucheck holds this one against the CPU's over a
// spread of values and fails if they part company. A preview graded differently
// from the still it is previewing is worse than no preview.

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba32f, binding = 0) readonly  uniform image2D uAccum;  // sums
layout(rgba8,   binding = 1) writeonly uniform image2D uOut;    // what is shown

uniform ivec2 uSize;
uniform int   uSampleCount;   // what to divide the sums by
uniform float uExposure;
uniform float uHueShift;      // degrees
uniform float uSaturation;
uniform float uValue;
uniform float uWarmth;        // white balance: + warms, - cools
uniform float uContrast;      // S-curve around mid grey

vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}
vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

vec3 aces(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// composite.frag's curves, verbatim (see there for what each is for).
uniform int uCurve;          // 0 ACES, 1 AgX, 2 PBR Neutral
uniform float uVignette;     // lens vignette after the grade (0 = off)

vec3 agx(vec3 v) {
    const mat3 inset = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051,
                            0.0784335999999992, 0.878468636469772, 0.0784336,
                            0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const float minEv = -12.47393, maxEv = 4.026069;
    v = inset * (v * 2.2409);
    v = clamp(log2(max(v, vec3(1e-10))), minEv, maxEv);
    v = (v - minEv) / (maxEv - minEv);
    vec3 x2 = v * v, x4 = x2 * x2;
    v = 15.5 * x4 * x2 - 40.14 * x4 * v + 31.96 * x4
      - 6.868 * x2 * v + 0.4298 * x2 + 0.1191 * v - 0.00232;
    // The "punchy" look (Blender's): a power and a saturation lift on the
    // display values, which is what brings AgX's deliberately flat base back
    // to the contrast a game is expected to have.
    v = pow(max(v, vec3(0.0)), vec3(1.35));
    float lu = dot(v, vec3(0.2126, 0.7152, 0.0722));
    v = lu + 1.4 * (v - lu);
    return clamp(v, 0.0, 1.0);
}

vec3 pbrNeutral(vec3 c) {
    c *= 1.7050;
    const float start = 0.76, desat = 0.15;
    float x = min(c.r, min(c.g, c.b));
    float offset = (x < 0.08) ? x - 6.25 * x * x : 0.04;
    c -= offset;
    float peak = max(c.r, max(c.g, c.b));
    if (peak >= start) {
        const float d = 1.0 - start;
        float newPeak = 1.0 - d * d / (peak + d - start);
        c *= newPeak / peak;
        float g = 1.0 - 1.0 / (desat * (peak - newPeak) + 1.0);
        c = mix(c, vec3(newPeak), g);
    }
    return pow(clamp(c, 0.0, 1.0), vec3(1.0 / 2.2));
}

vec3 tonemapCurve(vec3 x) {
    x = max(x, vec3(0.0));
    if (uCurve == 1) return agx(x);
    if (uCurve == 2) return pbrNeutral(x);
    return pow(aces(x), vec3(1.0 / 2.2));
}

vec3 colorGrade(vec3 c) {
    // White balance, then the contrast S-curve, then hue/saturation/value. The
    // ORDER is part of the look: grading saturation before contrast gives a
    // visibly different picture from the same numbers.
    c *= vec3(1.0 + uWarmth * 0.5, 1.0 + uWarmth * 0.06, 1.0 - uWarmth * 0.45);
    c = clamp((c - 0.5) * (1.0 + uContrast) + 0.5, 0.0, 1.0);

    vec3 hsv = rgb2hsv(c);
    hsv.x = fract(hsv.x + uHueShift / 360.0);
    hsv.y = clamp(hsv.y * uSaturation, 0.0, 1.0);
    hsv.z = hsv.z * uValue;
    return hsv2rgb(hsv);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= uSize.x || px.y >= uSize.y) return;

    vec3 col = imageLoad(uAccum, px).rgb / float(max(uSampleCount, 1));

    // Bounded BEFORE the tonemap: ACES divides one polynomial by another, so an
    // infinity going in comes out a NaN and no clamp afterwards rescues it.
    col = min(col, vec3(50000.0));
    if (any(isnan(col))) col = vec3(0.0);

    col = tonemapCurve(col * uExposure);
    col = colorGrade(col);
    // composite.frag's vignette (pathtrace::vignette on the CPU).
    if (uVignette > 0.0) {
        vec2  s  = vec2(uSize);
        float aspect = s.x / s.y;
        vec2  d  = ((vec2(px) + 0.5) / s - 0.5) * vec2(aspect, 1.0);
        float r2 = dot(d, d) / (0.25 * (aspect * aspect + 1.0));
        col *= mix(1.0, 1.0 - 0.6 * r2 * r2 + 0.1 * r2, clamp(uVignette, 0.0, 1.0));
    }
    imageStore(uOut, px, vec4(clamp(col, 0.0, 1.0), 1.0));
}
